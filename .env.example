# nanoclaw-tesla needs no runtime environment variable. The Tessie access token
# is NOT configured here: it lives in the OneCLI vault as the secret
# "Tessie API token" (generic, host pattern api.tessie.com, header
# Authorization) and the gateway injects it on the wire. See docs/setup.md.
# Create or revoke the token at https://dash.tessie.com/settings/api

# GitHub Actions secrets — set in repo Settings → Secrets and variables → Actions,
# NOT copied into .env:
#   https://github.com/jbaruch/nanoclaw-tesla/settings/secrets/actions
# FLEET_DISPATCH_TOKEN — the token .github/workflows/review-trigger.yml reads to start the
#   review run in jbaruch/coding-policy. Create it with Actions: Read and write on
#   jbaruch/coding-policy.
FLEET_DISPATCH_TOKEN=

# TESSL_TOKEN authenticates the publish workflow's `tessl` steps (publish.yml).
TESSL_TOKEN=
